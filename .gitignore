# ============================================================
# Mitorix Monorepo — Root .gitignore
# Single source of truth for the entire monorepo.
# The frontend/.gitignore has been consolidated here.
# ============================================================

# ── Dependencies ─────────────────────────────────────────────
node_modules/
.pnp
.pnp.js
.pnpm-store/

# ── Environment Variables ─────────────────────────────────────
# NEVER commit real .env files — use .env.*.example as templates
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# ── Build Outputs ─────────────────────────────────────────────
dist/
build/
out/
.next/
backend/dist/

# ── Logs ──────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── OS and Editor Artifacts ───────────────────────────────────
.DS_Store
Thumbs.db
.idea/
*.swp
*.swo

# Note: .vscode/ is intentionally NOT ignored so shared workspace
# settings (extensions.json, settings.json) can be committed.

# ── Docker / Runtime Storage / Databases ──────────────────────
# These are runtime data dirs — never source-controlled
backend/qdrant_storage/
backend/storage/
backend/uploads/
mongo_data/

# ── TypeScript Build Info ──────────────────────────────────────
*.tsbuildinfo

# ── Keys and Certificates ─────────────────────────────────────
*.pem
*.key
*.p12
*.pfx

# ── Misc ──────────────────────────────────────────────────────
.cache/

# ── Large Generated / Exported Files in Root ──────────────────
# These are developer-local exports and not project source files
index.html
mitorix.txt

# ── Tailwind v4 / Turbopack Scanner Exclusions ────────────────
# Prevents Turbopack from scanning binary/non-code files during
# HMR recompilation when it walks up to the git root.
frontend/**/*.ico
frontend/**/*.png
frontend/**/*.jpg
frontend/**/*.jpeg
frontend/**/*.gif
frontend/**/*.svg
frontend/**/*.webp
frontend/**/*.ttf
frontend/**/*.eot
frontend/**/*.patch
frontend/**/*.html
frontend/**/*.md

# ── Test Coverage Output ──────────────────────────────────────
coverage/
backend/coverage/

DB.excalidraw