# ==============================================
# RepoLens — Production Environment Variables
# ==============================================
# Copy this file to .env.production and fill in your real secrets.
# cp .env.production.example .env.production

# ---- Server ----
PORT=5000
NODE_ENV=production

# ---- MongoDB (Docker internal) ----
# Uses Docker container name, NOT localhost
MONGO_URI=mongodb://mongodb:27017/RepoLens

# ---- Redis (Docker internal) ----
# Used by BullMQ job queues — points to the redis container
REDIS_URL=redis://redis:6379
REDIS_HOST=redis
REDIS_PORT=6379

# ---- Qdrant (Docker internal) ----
# Uses Docker container name, NOT localhost
QDRANT_URL=http://qdrant:6333
# Optional: Qdrant Cloud API key (leave blank for local Docker Qdrant)
QDRANT_API_KEY=

# ---- GitHub OAuth (for login) ----
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# ---- JWT ----
# Generate a strong random string: openssl rand -hex 32
JWT_SECRET=generate_a_strong_random_string_here

# ---- AI / LLM ----
GOOGLE_API_KEY=your_gemini_api_key

# ---- GitHub App (for private repo access) ----
GITHUB_APP_ID=your_app_id
# IMPORTANT: Encode the private key as a single line with \n for newlines.
# Docker's --env-file does NOT support multi-line values.
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# ---- Optional: Third-party APIs ----
MURF_API_KEY=
ASSEMBLYAI_API_KEY=

# ---- Optional: Sentry Error Tracking ----
SENTRY_DSN=

# ---- Frontend URL (for CORS) ----
# Set this to your production domain
FRONTEND_URL=https://your-domain.com
