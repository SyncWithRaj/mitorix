# ==============================================
# Mitorix — Environment Configuration Template
# ==============================================

# Port for the backend Express server
PORT=5000

# Execution mode: 'development' or 'production'
NODE_ENV=development

# Frontend application URL (used for CORS and redirect links)
FRONTEND_URL=http://localhost:3000

# Backend application base URL
BACKEND_URL=http://localhost:5000

# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/Mitorix

# Redis connection settings (used for caching and background queues)
REDIS_URL=redis://127.0.0.1:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# Qdrant Vector Database settings (used for code chunk embeddings)
QDRANT_URL=http://127.0.0.1:6333
# Leave empty for local Docker instance, set if using Qdrant Cloud
QDRANT_API_KEY=

# Secret string used to sign and verify JWT authentication tokens
JWT_SECRET=generate_a_strong_random_string_here

# GitHub OAuth App credentials (used for User Sign-in with GitHub)
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Cohere API Key(s) for search reranking and embeddings (comma-separated for rotation)
COHERE_API_KEY=your_cohere_api_key(s)

# Groq API Key(s) for fast LLM inference (comma-separated for rotation)
GROQ_API_KEY=your_groq_api_key(s)

# Google Gemini API Key(s) for LLM generation & embeddings (comma-separated for rotation)
GOOGLE_API_KEY=your_gemini_api_key(s)

# Murf AI API Key for text-to-speech audio generation
MURF_API_KEY=

# AssemblyAI API Key for voice call speech-to-text transcription
ASSEMBLYAI_API_KEY=

# GitHub App ID for repository analysis & PR webhooks
GITHUB_APP_ID=your_app_id

# GitHub App Private Key in PEM format (newline-escaped string)
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# Hostname of the SMTP server (e.g., smtp.gmail.com)
SMTP_HOST=

# Port of the SMTP server (e.g., 587 for TLS, 465 for SSL)
SMTP_PORT=

# Username/email address for SMTP authentication
SMTP_USER=

# Password or App Password for SMTP authentication
SMTP_PASS=

# Recipient email address for contact form notifications
CONTACT_EMAIL_TO=